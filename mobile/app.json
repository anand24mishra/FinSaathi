{
  "expo": {
    "name": "FinSaathi · फ़िनसाथी",
    "slug": "finsaathi",
    "scheme": "finsaathi",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1747C7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.finsaathi.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "FinSaathi · फ़िनसाथी"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      "./plugins/withReleaseSigning",
      ["expo-audio", { "microphonePermission": "FinSaathi needs the microphone so you can ask questions by voice. / आवाज़ से सवाल पूछने के लिए FinSaathi को माइक चाहिए।" }],
      "expo-web-browser"
    ]
  }
}
