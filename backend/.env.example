# Copy to .env (gitignored). JWT_SECRET is generated automatically on first start if missing.
JWT_SECRET=
# Optional AI narration + assistant. Order used: Gemini (if a key is set) -> Anthropic (if set) -> rules engine (always works, labelled).
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extra keys (comma-separated). If one hits its quota or fails, the next is used automatically.
GEMINI_API_KEYS=
# Optional model fallback chain (comma-separated, tried in order). Defaults are built in.
GEMINI_MODELS=
ANTHROPIC_API_KEY=
# Optional tuning
PORT=4000
# 0.0.0.0 lets a phone on the same Wi-Fi reach the API (needed for Expo Go). Use 127.0.0.1 to lock to this machine.
HOST=0.0.0.0
PUSH_ENABLED=true
SCHEDULER_ENABLED=true
LOG_LEVEL=info
# Optional X (Twitter) chatter in the news hub. Leave empty to keep X off (shown as "not configured").
# X API is pay-per-use, about $0.005 per post read: https://developer.x.com
X_BEARER_TOKEN=
# Hard cap on X post reads per UTC day (default 200 = about $1/day worst case). Results are cached 15 minutes.
X_DAILY_READ_CAP=
# Optional Telegram. Public channel previews are read from an operator allow-list of reputable NEWS/official channels only
# (default: livemint, hindubusinessline; verified in src/market/providers/telegram.ts). Tip-like posts are dropped; items show as unverified chatter.
# Comma-separated handles, no @. Never add tipster channels. Users cannot add channels from the app.
TELEGRAM_CHANNELS=
# Optional alerts bot: create one with @BotFather and paste its token. Leave empty to keep Telegram off (shown as "not configured").
# Users link their OWN private chat from the app; the bot sends alerts and answers /calls and /note, it never posts into groups.
TELEGRAM_BOT_TOKEN=
# Set false to keep the bot from polling even when a token is present.
TELEGRAM_ENABLED=true

# Angel One SmartAPI (free live NSE data). The backend logs itself in with a TOTP it generates, so there is no token to paste
# or redeploy. Create the app at smartapi.angelone.in (API key), enable TOTP (secret), then set all four:
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
